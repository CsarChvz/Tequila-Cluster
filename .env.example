# =====================================================================
# Tequila Cluster Traceability System - docker compose environment
# Copy this file to ".env" (repo root) and set real values.
# NEVER commit ".env". Used by compose.yml to configure both the
# "db" (PostgreSQL) and "app" (Spring Boot) services, in that order.
# See also: src/main/resources/static/backend.env.example
# =====================================================================

# ---------------------------------------------------------------------
# PostgreSQL container ("db" service)
# ---------------------------------------------------------------------
POSTGRES_DB=tequila_cluster
POSTGRES_USER=tequila_admin
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ---------------------------------------------------------------------
# Spring Boot application ("app" service)
# ---------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRATION_MINUTES=60
PLANT_MAX_CAPACITY_KG=50000
RETENTION_YEARS=5
