# ==========================================
# 1. CONFIGURACIÓN DE LA APLICACIÓN
# ==========================================
# URL pública de tu aplicación (útil para SEO, sitemaps o redirecciones absolutas)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# 2. CONSUMO DE LA API PRINCIPAL
# ==========================================
# URL base de tu backend / API
NEXT_PUBLIC_API_BASE_URL=https://api.tu-dominio.com/v1

# API Key estática para identificar la app cliente ante el backend (si aplica)
# Nota: Si se usa solo en Server Components / Route Handlers, puedes quitar el prefijo NEXT_PUBLIC_
NEXT_PUBLIC_API_KEY=tu_api_key_secreta_aqui_12345

# ==========================================
# 3. AUTENTICACIÓN (JWT)
# ==========================================
# Tiempo de expiración estimado del token en el cliente (opcional, para lógica visual)
NEXT_PUBLIC_JWT_EXPIRE_TIME=86400

NEXT_PUBLIC_JWT_STORAGE_KEY=tu_app_jwt_token

NODE_ENV=development

