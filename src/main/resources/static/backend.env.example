# =====================================================================
# Tequila Cluster Traceability System - Backend (Spring Boot)
# Copy this file to ".env" and set real values. NEVER commit ".env".
# =====================================================================

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
# Active environment profile. Allowed values: dev, uat, prod
SPRING_PROFILES_ACTIVE=dev
# Port where the backend REST API listens
SERVER_PORT=8080

# ---------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------
# JDBC connection URL of the PostgreSQL database
DB_URL=jdbc:postgresql://localhost:change_me
# Database user
DB_USERNAME=change_me
# Database password (secret)
DB_PASSWORD=change_me

# ---------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------
# Secret key used to sign session tokens (JWT). Use a long random string (secret)
JWT_SECRET=change_me_to_a_long_random_string
# Session token lifetime, in minutes
JWT_EXPIRATION_MINUTES=60

# ---------------------------------------------------------------------
# Process (configurable variables — FR-11/RB-104, NFR-17)
# ---------------------------------------------------------------------
# Plant maximum processing capacity, in kg. Non-blocking warning above this value.
PLANT_MAX_CAPACITY_KG=50000
# Minimum retention period for traceability records, in years
RETENTION_YEARS=5
